<Window x:Class="TrabajoFinalWPF.Views.DocenteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Administrador"
        Height="750"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0B6E4F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#E8F5F0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#084C3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#084C3D">
            <StackPanel Margin="20">
                <!-- FIX: mostrar nombre del administrador actual -->
                <TextBlock x:Name="txtNombreAdmin"
                           FontSize="18" FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10,0,4"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <TextBlock Text="Administrador"
                           FontSize="13"
                           Foreground="#A8D8C8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>
                <Button Content="Crear Egresado" Click="Agregar_Click" Background="#0B6E4F"/>
            </StackPanel>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Panel de Gestión de Egresados"
                           FontSize="30" FontWeight="Bold" Foreground="#084C3D"/>
                <TextBlock Text="Administra egresados, cuestionarios y niveles de deserción académica."
                           FontSize="15" Foreground="#555"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="15">
                <DataGrid x:Name="dg" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre"         Binding="{Binding Nombre}"                  Width="*"/>
                        <DataGridTextColumn Header="Correo"         Binding="{Binding Gmail}"                   Width="*"/>
                        <DataGridTextColumn Header="Código Acceso"  Binding="{Binding CodigoEstudiantil}"       Width="*"/>
                        <DataGridTextColumn Header="Nivel Deserción" Binding="{Binding NivelDesercionAcademica}" Width="*"/>
                        <DataGridTextColumn Header="Cuestionarios"  Binding="{Binding Cuestionarios.Count}"     Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
