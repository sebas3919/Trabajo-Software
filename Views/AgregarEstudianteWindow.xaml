<Window x:Class="TrabajoFinalWPF.Views.AgregarEstudianteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Egresado"
        Height="520"
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B6E4F">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B6E4F"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#084C3D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ErrorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CC0000"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="420"
                Background="White"
                CornerRadius="18"
                Padding="35"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock Text="Crear Nuevo Egresado"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#084C3D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Nombre completo" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                <TextBox x:Name="txtNombre"/>
                <TextBlock x:Name="lblErrorNombre" Style="{StaticResource ErrorLabel}"/>

                <TextBlock Text="Correo institucional" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                <TextBox x:Name="txtCorreo"/>
                <TextBlock x:Name="lblErrorCorreo" Style="{StaticResource ErrorLabel}"/>

                <Button Content="CREAR EGRESADO" Click="Crear_Click" Background="#0B6E4F"/>

                <TextBlock Text="El sistema generará automáticamente un código de acceso para el egresado."
                           TextWrapping="Wrap" FontSize="12" Foreground="#555"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
