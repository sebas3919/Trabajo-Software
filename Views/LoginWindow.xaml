<Window x:Class="TrabajoFinalWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Seguimiento"
        Height="660"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B6E4F">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B6E4F"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B6E4F"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#084C3D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ErrorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CC0000"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="420"
                Background="White"
                CornerRadius="18"
                Padding="35"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>

                <TextBlock Text="Sistema de Seguimiento"
                           FontSize="28" FontWeight="Bold"
                           Foreground="#084C3D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Correo institucional" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                <TextBox x:Name="txtCorreo"/>
                <TextBlock x:Name="lblErrorCorreo" Style="{StaticResource ErrorLabel}"/>

                <TextBlock Text="Contraseña o Código" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                <PasswordBox x:Name="txtClave"/>
                <TextBlock x:Name="lblErrorClave" Style="{StaticResource ErrorLabel}"/>

                <Button Content="INICIAR SESIÓN" Click="Login_Click" Background="#0B6E4F"/>

                <Separator Margin="0,20"/>

                <TextBlock Text="Registro exclusivo para administradores"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#084C3D"
                           HorizontalAlignment="Center"
                           Margin="0,5"/>

                <TextBlock Text="Código administrativo" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                <TextBox x:Name="txtCodigoAdmin"/>
                <TextBlock x:Name="lblErrorCodigo" Style="{StaticResource ErrorLabel}"/>

                <Button Content="REGISTRAR ADMINISTRADOR" Click="RegistroAdmin_Click" Background="#084C3D"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
